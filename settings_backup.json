// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "session": {
    "trust_all_worktrees": true
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "hover_popover_enabled": true,
  "hover_popover_delay": 0,
  "languages": {
    "JavaScript": {
      "soft_wrap": "preferred_line_length",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      },
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    }
  },
  "disable_ai": false,
  "toolbar": {
    "code_actions": false,
    "quick_actions": true
  },
  "ui_font_family": ".ZedSans",
  "buffer_font_weight": 400.0,
  "buffer_font_family": "JetBrains Mono",
  "features": {
    "edit_prediction_provider": "copilot"
  },
  "wsl_connections": [
    {
      "distro_name": "Ubuntu-22.04",
      "user": null,
      "projects": [
        {
          "paths": ["/home/foxxgreeley"]
        },
        {
          "paths": [
            "/home/foxxgreeley/laravel/apps/contact-north-chatgpt-experiments"
          ]
        },
        {
          "paths": ["/home/foxxgreeley/nextjs"]
        },
        {
          "paths": ["/home/foxxgreeley/nextjs/contact-north-ai-tools/./"]
        }
      ]
    }
  ],
  "agent": {
    "dock": "right",
    "always_allow_tool_actions": true,
    "profiles": {},
    "default_profile": "ask",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini"
    },
    "model_parameters": []
  },
  "project_panel": {
    "file_icons": true,
    "dock": "left"
  },
  "tabs": {
    "git_status": true
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_icon": true
  },
  "search": {
    "button": true
  },
  "terminal": {
    "shell": {
      "program": "C:\\Program Files\\Git\\bin\\bash.exe"
    },
    "toolbar": {
      "breadcrumbs": false
    },
    "cursor_shape": "bar",
    "font_weight": 400.0,
    "font_family": ".ZedMono",
    "font_size": 15.0,
    "dock": "bottom"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "base_keymap": "JetBrains",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Colored Zed Icons Theme Dark"
  },
  "ui_font_size": 16,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Colorizer"
  }
}
